{
  "name": "coding-agents-mcp",
  "version": "0.4.0",
  "description": "Universal Model Context Protocol (MCP) gateway & orchestrator for autonomous AI coding agents: Anthropic Claude Code, Google Antigravity, OpenAI Codex, and Cursor Agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coding-agents-mcp": "dist/index.js",
    "agy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/test-runner.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkyfunc/coding-agents-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/funkyfunc/coding-agents-mcp/issues"
  },
  "homepage": "https://github.com/funkyfunc/coding-agents-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "coding-agents",
    "ai-agents",
    "agent-tools",
    "claude-code",
    "antigravity",
    "agy",
    "codex",
    "cursor",
    "cursor-agent",
    "developer-tools",
    "pair-programming",
    "orchestrator",
    "multi-agent",
    "git-worktree",
    "agent-handoff",
    "cli",
    "llm"
  ],
  "author": "funkyfunc",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
